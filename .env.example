# ---------------------------------------------------------------------------
# Backend. Copy to backend/.env for local development.
# Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Google Cloud / BigQuery
GCP_PROJECT_ID=your-gcp-project
BQ_DATASET=sales_incentive
BQ_LOCATION=asia-south1
# Local development only. On Cloud Run leave this unset and attach a service
# account instead, so no key file exists anywhere.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/bigquery-sa.json

# Authentication
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_TTL_MINUTES=480
ALLOWED_EMAIL_DOMAINS=marrowmed.com,dailyrounds.org

# Where each month's sales are read from. A row in `source_table_config`
# overrides this per period, set with scripts/connect_source.py or POST /api/sources.
# Leave SOURCE_DATASET unset to use uploaded files instead.
SOURCE_PROJECT=primeval-door-448605-f4
SOURCE_DATASET=Monthly_Sub
# {MMM}=Aug {MM}=08 {YYYY}=2026 {YY}=26 {period}=2026-08
SOURCE_TABLE_TEMPLATE={MMM}_{YYYY}_v1
# Confirmed against Monthly_Sub.Aug_2026_v1: payment_date_ist is a TIMESTAMP,
# so the month filter is a range on the raw column and prunes partitions.
SOURCE_DATE_COLUMN=payment_date_ist

# Upload staging
GCS_UPLOAD_BUCKET=your-project-incentive-uploads

# Business configuration. These are policy values, not code constants, so a
# change of ARPU or cap does not need a deployment.
DEFAULT_ARPU=33000
MONTHLY_PAYOUT_CAP=200000
REFUND_HANDLING=exclude
TREAT_ZERO_SALES_AS_EXIT=true

# Local development sign-in. Never set these on a deployed instance: the
# endpoint is not registered at all unless ALLOW_DEV_LOGIN is true.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_EMAIL=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend. Copy to frontend/.env.local.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false
